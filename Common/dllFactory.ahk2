;----------------------------------------------------------------------------
; GDI Stuff
;----------------------------------------------------------------------------
Class myGDI {
   #DllLoad "Gdi32.dll"

   /**
    * Draw a border around a region using the specified brush.
    * @param {Integer} HDC Device context
    * @param {Integer} HRGN Region to frame
    * @param {Integer} HBrush Brush used to draw the border
    * @param {Integer} Width Width of vertical brush strokes (logical units)
    * @param {Integer} Height Height of horizontal brush strokes (logical units)
    * @returns {Integer} Nonzero on success
    */
   Static FrameRgn(HDC, HRGN, HBrush, Width, Height) {
      Return DllCall("Gdi32.dll\FrameRgn", "Ptr", HDC, "Ptr", HRGN, "Ptr", HBrush, "Int", Width, "Int", Height, "Int")
   }
   /**
    * Create a rectangular region with rounded corners.
    * @param {Integer} Left X of upper-left corner
    * @param {Integer} Top Y of upper-left corner
    * @param {Integer} Right X of lower-right corner
    * @param {Integer} Bottom Y of lower-right corner
    * @param {Integer} RX Width of the corner ellipse
    * @param {Integer} RY Height of the corner ellipse
    * @returns {Integer} Region handle (HRGN), or 0 on failure
    */
   Static CreateRoundRectRgn(Left, Top, Right, Bottom, RX, RY) {
      Return DllCall("Gdi32.dll\CreateRoundRectRgn", "Int", Left, "Int", Top, "Int", Right, "Int", Bottom, "Int", RX, "Int", RY, "Ptr")
   }
   /**
    * Create a rectangular region.
    * @param {Integer} Left X of upper-left corner
    * @param {Integer} Top Y of upper-left corner
    * @param {Integer} Right X of lower-right corner
    * @param {Integer} Bottom Y of lower-right corner
    * @returns {Integer} Region handle (HRGN), or 0 on failure
    */
   Static CreateRectRgn(Left, Top, Right, Bottom) {
      Return DllCall("Gdi32.dll\CreateRectRgn", "Int", Left, "Int", Top, "Int", Right, "Int", Bottom, "Ptr")
   }
   /**
    * Select a region as the current clipping region for a device context.
    * @param {Integer} HDC Device context
    * @param {Integer} hrgn Region handle (0 removes clipping)
    * @returns {Integer} Region complexity (NULLREGION/SIMPLEREGION/COMPLEXREGION) or ERROR (0)
    */
   Static SelectClipRgn(HDC, hrgn) => DllCall("Gdi32.dll\SelectClipRgn", "Ptr", HDC, "Ptr", hrgn, "Int")
   /**
    * Delete a GDI object, logging a warning on failure.
    * @param {Integer} p_object GDI object handle (pen, brush, font, bitmap, region)
    * @param {String} desc Optional description used in the failure message
    * @returns {Integer} Nonzero on success
    */
   Static DeleteObject(p_object, desc := "") {
      res := DllCall("Gdi32.dll\DeleteObject", "Ptr", p_object, "Int")
      If (res = 0)
         warning("Failed to delete object " desc " " p_object)
      Return res
   }
   /**
    * Get the current background color of a device context.
    * @param {Integer} hdc Device context
    * @returns {Integer} COLORREF (BGR), or CLR_INVALID on failure
    */
   Static GetBkColor(hdc)               => DllCall("Gdi32.dll\GetBkColor", "Ptr", hdc, "UInt")
   /**
    * Fill a region using the specified brush.
    * @param {Integer} hdc Device context
    * @param {Integer} rgnMain Region handle
    * @param {Integer} hBrush Brush handle
    * @returns {Integer} Nonzero on success
    */
   Static FillRgn(hdc, rgnMain, hBrush) => DllCall("Gdi32.dll\FillRgn", "Ptr", hdc, "Ptr", rgnMain, "Ptr", hBrush, "Int")
   /**
    * Create a solid brush. Delete with myGDI.DeleteObject when done.
    * @param {Integer} rgbColor COLORREF (BGR)
    * @returns {Integer} Brush handle, or 0 on failure
    */
   Static CreateSolidBrush(rgbColor)    => DllCall("Gdi32.dll\CreateSolidBrush", "UInt", rgbColor, "Ptr")
   /**
    * Get a cached system color brush (do not delete).
    * @param {Integer} index COLOR_* index
    * @returns {Integer} Brush handle, or 0 on failure
    */
   Static GetSysColorBrush(index)       => DllCall("User32.dll\GetSysColorBrush", "Int", index, "Ptr")
   /**
    * Create a solid (PS_SOLID) pen. Delete with myGDI.DeleteObject when done.
    * @param {Integer} Width Pen width in logical units
    * @param {Integer} Color COLORREF (BGR)
    * @returns {Integer} Pen handle, or 0 on failure
    */
   Static CreateSolidPen(Width, Color)  => DllCall("Gdi32.dll\CreatePen", "Int", 0, "Int", Width, "UInt", Color, "Ptr")
   /**
    * Fill a rectangle using the specified brush.
    * @param {Integer} hdc Device context
    * @param {Integer} pRect Pointer to a RECT
    * @param {Integer} hBrush Brush handle (or COLOR_* index + 1)
    * @returns {Integer} Nonzero on success
    */
   Static FillRect(hdc, pRect, hBrush)  => DllCall("User32.dll\FillRect", "Ptr", hdc, "Ptr", pRect, "Ptr", hBrush, "Int")
   /**
    * Select an object into a device context.
    * TODO - https://learn.microsoft.com/en-us/windows/win32/api/wingdi/nf-wingdi-createfontw
    * @param {Integer} hDC Device context
    * @param {Integer} hObject GDI object handle
    * @returns {Integer} Handle of the previously selected object (restore it before deleting hObject)
    */
   Static SelectObject(hDC, hObject) => DllCall("Gdi32.dll\SelectObject", "Ptr", hDC, "Ptr", hObject, "Ptr")
   /**
    * Get a copy of a window's region, so it can be modified after it is set.
    * The caller owns the returned region and must delete it.
    * @param {Integer} hWnd Window handle
    * @param {VarRef} hRgnNew Also receives the region handle (or 0)
    * @returns {Integer} Region handle, or 0 if the window has no region
    */
   Static GetTempWindowRgn(hWnd, &hRgnNew := 0) {
      hRgn := myGDI.CreateRectRgn(0, 0, 0, 0)
      ; The GetWindowRgn function obtains a copy of the window region of a window
      If (myGDI.GetWindowRgn(hWnd, hRgn)) {
         Return hRgnNew := hRgn
      } Else {
         myGDI.DeleteObject(hRgn)
         Return hRgnNew := 0
      }
   }
   /**
    * Copy a window's region into an existing region.
    * @param {Integer} hWnd Window handle
    * @param {Integer} hRgn Region that receives the copy
    * @returns {Integer} Region complexity, or ERROR (0) if the window has no region
    */
   Static GetWindowRgn(hWnd, hRgn) => DllCall("User32.dll\GetWindowRgn", "Ptr", hWnd, "Ptr", hRgn, "Int")
   /**
    * Set the window to only show the specified region (transparent elsewhere).
    * The system owns the region after a successful call - do not delete it.
    * @param {Integer} HWND Window handle
    * @param {Integer} HRGN Region handle (0 removes the region)
    * @param {Integer} Redraw true to redraw the window
    * @returns {Integer} Nonzero on success
    */
   Static SetWindowRgn(HWND, HRGN, Redraw := true) {
      Return DllCall("User32.dll\SetWindowRgn", "Ptr", HWND, "Ptr", HRGN, "Int", !!Redraw, "Int")
   }
   /**
    * Delete a device context created with CreateDC/CreateCompatibleDC.
    * Use ReleaseDC for DCs obtained with GetDC/GetWindowDC.
    * @param {Integer} p_dc Device context
    * @returns {Integer} Nonzero on success
    */
   Static DeleteDC(p_dc) => DllCall("Gdi32.dll\DeleteDC", "Ptr", p_dc, "Int")
   /**
    * Get the client-area device context of a window. Release with ReleaseDC.
    * @param {Integer} HWND Window handle (0 = entire screen)
    * @returns {Integer} Device context, or 0 on failure
    */
   Static GetDC(HWND) => DllCall("User32.dll\GetDC", "Ptr", HWND, "Ptr")
   /**
    * Get the device context of an entire window (including non-client area). Release with ReleaseDC.
    * @param {Integer} HWND Window handle
    * @returns {Integer} Device context, or 0 on failure
    */
   Static GetWindowDC(HWND) => DllCall("User32.dll\GetWindowDC", "Ptr", HWND, "Ptr")
   /**
    * Release a device context obtained with GetDC/GetWindowDC.
    * @param {Integer} HWND Window the DC belongs to
    * @param {Integer} HDC Device context
    * @returns {Integer} 1 if released, 0 otherwise
    */
   Static ReleaseDC(HWND, HDC) => DllCall("User32.dll\ReleaseDC", "Ptr", HWND, "Ptr", HDC, "Int")
   /*
      stHFONT._pszFaceName=148123348
      stHFONT.bItalic=0
      stHFONT.bStrikeOut=0
      stHFONT.bUnderline=0
      stHFONT.cEscapement=0
      stHFONT.cHeight=-32
      stHFONT.cOrientation=0
      stHFONT.cWeight=400
      stHFONT.cWidth=0
      stHFONT.iCharSet=1
      stHFONT.iClipPrecision=0
      stHFONT.iOutPrecision=4
      stHFONT.iPitchAndFamily=0
      stHFONT.iQuality=0
      stHFONT.pszFaceName=Segoe UI Symbol
   */
   /**
    * Create a logical font. Delete with myGDI.DeleteObject when done.
    * @param {String} Face Typeface name (32 chars max)
    * @param {Integer} Height Em height in logical units (negative = character height, 0 = default)
    * @param {Integer} Weight Font weight (400 = normal, 700 = bold)
    * @returns {Integer} Font handle (HFONT), or 0 on failure
    */
   Static CreateFont(Face, Height := 0, Weight := 400) {
      Return DllCall("Gdi32\CreateFont"
         , "Int", Height 	; _In_ int       	  nHeight, in logical units also known as the em height
         , "Int", 0         	; _In_ int       	  nWidth,
         , "Int", 0        	; _In_ int       	  nEscapement,
         , "Int", 0        	; _In_ int       	  nOrientation,
         , "Int", Weight ; _In_ int        	  fnWeight,
         , "UInt", 0     	; _In_ DWORD   fdwItalic,
         , "UInt", 0     	; _In_ DWORD   fdwUnderline,
         , "UInt", 0     	; _In_ DWORD   fdwStrikeOut,
         , "UInt", 0     	; _In_ DWORD   fdwCharSet, (ANSI_CHARSET)
         , "UInt", 0     	; _In_ DWORD   fdwOutputPrecision, (OUT_DEFAULT_PRECIS)
         , "UInt", 0     	; _In_ DWORD   fdwClipPrecision, (CLIP_DEFAULT_PRECIS)
         , "UInt", 0     	; _In_ DWORD   fdwQuality, (DEFAULT_QUALITY)
         , "UInt", 0     	; _In_ DWORD   fdwPitchAndFamily, (FF_DONTCARE|DEFAULT_PITCH)
         , "Str", Face   	; _In_ LPCTSTR  lpszFace typeface name of the font (32 char max)
         , "Ptr")
   }
   /**
    * Get a control's current font and fill a LOGFONT structure with its attributes.
    * @param {Integer} hWnd Control handle
    * @param {Object} cFont LOGFONT structure (stHFONT) that receives the font attributes
    * @returns {Integer} Font handle (HFONT) used by the control (0 = system font)
    */
   Static getDefaultFont(hWnd, cFont) {
      Static WM_GETFONT        := 0x0031
      defFont := SendMessage(WM_GETFONT, 0,,,hWnd)
      DllCall("Gdi32\GetObject", "Ptr", defFont, "Int", cFont.Size, "Ptr", cFont.Ptr, "Int")
      return defFont
   }
   /**
    * Create a font from a populated LOGFONT structure. Delete with myGDI.DeleteObject when done.
    * @param {Object} cFont LOGFONT structure (stHFONT)
    * @returns {Integer} Font handle (HFONT), or 0 on failure
    */
   Static CreateFontIndirect(cFont) {
      return DllCall("Gdi32\CreateFontIndirect", "Ptr", cFont.Ptr, "Ptr")
   }
   /*
   DrawText() Format Flags
      DT_TOP                      0x00000000
      DT_LEFT                     0x00000000 o
      DT_CENTER                   0x00000001 o
      DT_RIGHT                    0x00000002 o
      DT_VCENTER                  0x00000004 d
      DT_BOTTOM                   0x00000008
      DT_WORDBREAK                0x00000010 d off for measure
      DT_SINGLELINE               0x00000020
      DT_EXPANDTABS               0x00000040
      DT_TABSTOP                  0x00000080
      DT_NOCLIP                   0x00000100 d
      DT_EXTERNALLEADING          0x00000200
      DT_CALCRECT                 0x00000400 measure only
      DT_NOPREFIX                 0x00000800 d
      DT_INTERNAL                 0x00001000
      DT_EDITCONTROL              0x00002000
      DT_PATH_ELLIPSIS            0x00004000
      DT_END_ELLIPSIS             0x00008000
      DT_MODIFYSTRING             0x00010000
      DT_RTLREADING               0x00020000
      DT_WORD_ELLIPSIS            0x00040000
      DT_NOFULLWIDTHCHARBREAK     0x00080000
      DT_HIDEPREFIX               0x00100000
      DT_PREFIXONLY               0x00200000
   */
   /**
    * Draw formatted text into a rectangle.
    * @param {Integer} hDC DC to draw text into
    * @param {String} lpchText Text string to draw
    * @param {Integer} lpRect Pointer to the RECT to draw in (updated when DT_CALCRECT is used)
    * @param {Integer} uFormat DT_* formatting flags
    * @returns {Integer} Height of the text in logical units, or 0 on failure
    */
   Static DrawText(hDC, lpchText, lpRect, uFormat := 0) {
      return DllCall("User32\DrawText", "Ptr", hDC, "Str", lpchText, "Int", -1, "Ptr", lpRect, "UInt", uFormat, "Int")
   }
}

/*
An em is equal to the current font-size, for instance, if the font-size of the document
is 12pt, 1em is equal to 12pt. Ems are scalable in nature, so 2em would equal 24pt, .
5em would equal 6pt, etc.. Percent (%): The percent unit is much like the “em” unit,
save for a few fundamental differences
*/

;----------------------------------------------------------------------------
; Kernel32
;----------------------------------------------------------------------------
/**
 * Allocate global memory (e.g. for clipboard data).
 * @param {Integer} uFlags GMEM_* flags
 * @param {Integer} dwBytes Number of bytes to allocate
 * @returns {Integer} Memory handle (HGLOBAL), or 0 on failure
 */
GlobalAlloc(uFlags, dwBytes) => DllCall("Kernel32.dll\GlobalAlloc", "UInt", uFlags, "UPtr", dwBytes, "Ptr")
/**
 * Lock a global memory object and return a pointer to its first byte.
 * @param {Integer} hMem Memory handle
 * @returns {Integer} Pointer to the memory, or 0 on failure
 */
GlobalLock(hMem) => DllCall("Kernel32.dll\GlobalLock", "Ptr", hMem, "Ptr")
/**
 * Decrement the lock count of a global memory object.
 * @param {Integer} hMem Memory handle
 * @returns {Integer} Nonzero if still locked, 0 if unlocked (check A_LastError)
 */
GlobalUnlock(hMem) => DllCall("Kernel32.dll\GlobalUnlock", "Ptr", hMem, "Int")
/**
 * Free a global memory object.
 * @param {Integer} hMem Memory handle
 * @returns {Integer} 0 on success, otherwise hMem
 */
GlobalFree(hMem) => DllCall("Kernel32.dll\GlobalFree", "Ptr", hMem, "Ptr")
/**
 * Get the frequency of the performance counter (counts per second).
 * @param {VarRef} freq Receives the frequency
 * @returns {Integer} Nonzero on success
 */
QueryPerformanceFrequency(&freq) => DllCall("Kernel32.dll\QueryPerformanceFrequency", "Int64*", &freq, "Int")
/**
 * Get the current value of the performance counter.
 * @param {VarRef} nowt Receives the counter value
 * @returns {Integer} Nonzero on success
 */
QueryPerformanceCounter(&nowt) => DllCall("Kernel32.dll\QueryPerformanceCounter", "Int64*", &nowt, "Int")

;----------------------------------------------------------------------------
; NTDll
;----------------------------------------------------------------------------
/**
 * Copy a block of memory (source and destination may overlap).
 * @param {Integer} pDestination Destination address
 * @param {Integer} pSource Source address
 * @param {Integer} Length Number of bytes to copy (SIZE_T)
 * @returns {void}
 */
RtlMoveMemory(pDestination, pSource, Length) => DllCall("Ntdll.dll\RtlMoveMemory", "Ptr", pDestination, "Ptr", pSource, "UPtr", Length)


;============================================================================
;           Other Common Window Related Functions
;============================================================================
; GroupAdd("InvalidCandidate", "ahk_class Ghost")	; Hung windows
; GroupAdd("InvalidCandidate", "ahk_class Windows.UI.Core.CoreWindow")	; Releated to start menu/UWP
; GroupAdd("InvalidCandidate", "ahk_class Windows.UI.Core.AppWindow")	; Releated to start menu/UWP
; GroupAdd("InvalidCandidate", "ahk_class MS-SDIa")	; Project Child windows that show up as main windows
; GroupAdd("InvalidCandidate", "ahk_class MS-SDIb")	; Excel Child windows that show up as main windows
; GroupAdd("InvalidCandidate", "ahk_class IME")	  ; UWP Phantom WIndow
; GroupAdd("InvalidCandidate", "ahk_class WorkerW")	; UWP Phantom Window

/**
 * Enable a dark title bar for a window.
 * https://docs.microsoft.com/en-us/windows/apps/desktop/modernize/apply-windows-themes
 * Attribute 20 is used on build 18985+ (Win10 20H1 / Win11), 19 on earlier Win10 builds.
 * @param {Integer} hWnd Window handle
 * @returns {Integer} HRESULT (0 = S_OK)
 */
Dark11Mode(hWnd) {
   Static DWMWA_USE_IMMERSIVE_DARK_MODE := (VerCompare(A_OSVersion, "10.0.18985") >= 0) ? 20 : 19
   ; SetWindowTheme(window, L"DarkMode_Explorer", NULL);  can apply this is a list view
   ; Round corners on windows 11: DWMWA_WINDOW_CORNER_PREFERENCE = 33, DWMWCP_ROUND = 2
   Return DllCall("dwmapi\DwmSetWindowAttribute"
      , "Ptr", hWnd
      , "UInt", DWMWA_USE_IMMERSIVE_DARK_MODE
      , "Int*", 1
      , "UInt", 4
      , "Int")
}
/**
 * Check whether the workstation is unlocked (the input desktop can be opened).
 * @returns {Integer} true if unlocked, false if locked or on the secure desktop
 */
WorkstationIsUnLocked() {
   hDesk := DllCall("User32\OpenInputDesktop", "UInt", 0, "Int", false, "UInt", 0x0001, "Ptr") ; DESKTOP_READOBJECTS
   If (!hDesk)
      Return false
   DllCall("User32\CloseDesktop", "Ptr", hDesk)
   Return true
}
/**
 * Return the major Windows version.
 * @returns {Integer} 10 or 11 (build 22000+)
 */
OSVersion() => StrSplit(A_OSVersion, ".")[3] < 22000 ? 10 : 11

/**
 * Build a compacted RGB hex string from components.
 * @param {Integer} r Red 0-255
 * @param {Integer} g Green 0-255
 * @param {Integer} b Blue 0-255
 * @returns {String} Color as "0xRRGGBB"
 */
RGB(r, g, b) => Format("0x{1:02x}{2:02x}{3:02x}", r, g, b)
/**
 * Convert an AHK color (cFFFFFF / FFFFFF / 0xFFFFFF / name) to a numeric RGB value.
 * @param {String|Integer} color Color value
 * @returns {Integer} RGB value
 */
colToHex(color) => _cleanRGB(color)
/**
 * Adjust the luminance of an RGB color by adding val to each channel (clamped 0-255).
 * @param {String|Integer} rgb Color as FFFFFF, cFFFFFF, 0xFFFFFF or name
 * @param {Integer} val Amount to add to each channel (negative darkens)
 * @returns {String} Adjusted color as "0xRRGGBB"
 */
lumRGB(rgb, val) {
   rgb := _cleanRGB(rgb)
   r := constrain(0, 255, ((rgb >>> 16) & 0xFF) + val)
   g := constrain(0, 255, ((rgb >>> 8) & 0xFF) + val)
   b := constrain(0, 255, ((rgb >>> 0) & 0xFF) + val)
   Return Format("0x{1:02x}{2:02x}{3:02x}", r, g, b)
}
/**
 * Split an RGB color (e.g. from PixelGetColor) into components.
 * @param {String|Integer} RGBColor Color value
 * @param {VarRef} Red Receives red 0-255
 * @param {VarRef} Green Receives green 0-255
 * @param {VarRef} Blue Receives blue 0-255
 * @returns {Integer} The largest of the three components
 */
GetRGB(RGBColor, &Red, &Green, &Blue) {
   RGBColor := _cleanRGB(RGBColor)
   Red := (RGBColor >>> 16) & 0xFF			; Calculate Red From Hex Value.
   Green := (RGBColor >>> 8) & 0xFF			; Calculate Green From Hex Value.
   Blue := (RGBColor & 0xFF)             ; Blue is lower word
   return Max(Red,Green,Blue)
}
/**
 * Normalize a color to a numeric RGB value, suitable for AHK and DllCall colors.
 * Accepts cFFFFFF, FFFFFF, 0xFFFFFF, an HTML color name, or an integer.
 * @param {String|Integer} rgb Color value
 * @returns {Integer} RGB value (0 for an empty string)
 */
_cleanRGB(rgb) {
   Static cMap := Map("AQUA", "0x00FFFF", "BLACK", "0x000000", "BLUE", "0x0000FF", "FUCHSIA", "0xFF00FF"
      , "GRAY", "0x808080", "GREEN", "0x008000", "LIME", "0x00FF00", "MAROON", "0x800000"
      , "NAVY", "0x000080", "OLIVE", "0x808000", "PURPLE", "0x800080", "RED", "0xFF0000"
      , "SILVER", "0xC0C0C0", "TEAL", "0x008080", "WHITE", "0xFFFFFF", "YELLOW", "0xFFFF00")

   Switch Type(rgb) {
      Case "Integer":
         Return rgb
      Case "String":
         If (rgb) {
            If (cMap.Has(StrUpper(rgb)))
               Return Integer(cMap[StrUpper(rgb)])
            ; Strip any "c" or "0x" prefix so short values like "0xFF" also work
            Return Integer("0x" RegExReplace(rgb, "i)^(0x|c)"))
         } else
            Return 0
      Default:
   }
   Return rgb
}
/**
 * Convert an RGB color (integer, hex string or HTML name) to BGR for Win32 APIs.
 * @param {String|Integer} Color RGB color
 * @param {Any} Default Unused
 * @returns {Integer|String} BGR value, or "" for an empty string
 */
toBGR(Color, Default := "") {
   ; HTML Colors (BGR)
   Static HTML := { AQUA: 0xFFFF00, BLACK: 0x000000, BLUE: 0xFF0000, FUCHSIA: 0xFF00FF, GRAY: 0x808080, GREEN: 0x008000
      , LIME: 0x00FF00, MAROON: 0x000080, NAVY: 0x800000, OLIVE: 0x008080, PURPLE: 0x800080, RED: 0x0000FF
      , SILVER: 0xC0C0C0, TEAL: 0x808000, WHITE: 0xFFFFFF, YELLOW: 0x00FFFF }
   Switch Type(Color) {
      Case "Integer":
         Return ((Color >> 16) & 0xFF) | (Color & 0x00FF00) | ((Color & 0xFF) << 16)
      Case "String":
         If (HTML.HasOwnProp(Color))
            Return HTML.%Color%
         Else If Color {
            Color := Integer("0x" SubStr(Color, -6))
            Return ((Color >> 16) & 0xFF) | (Color & 0x00FF00) | ((Color & 0xFF) << 16)
         } Else
            Return ""
   }
}
/**
 * Convert a relative path to a full, normalized path.
 * @param {String} path File path (relative or absolute)
 * @returns {String} Full path
 */
NormalizePath(path) {
   cc := DllCall("GetFullPathName", "Str", path, "UInt", 0, "Ptr", 0, "Ptr", 0, "UInt")
   buf := Buffer(cc * 2)
   DllCall("GetFullPathName", "Str", path, "UInt", cc, "Ptr", buf, "Ptr", 0, "UInt")
   Return StrGet(buf, "UTF-16")
}
;============================================================================
; Common routines, used by classes for debugging
;============================================================================
/**
 * Return the name of the function that called the current function.
 * @returns {String} Calling function name
 */
A_LastFunc() => Error("", -3).what
/**
 * OutputDebug a (D) message tagged with file, caller and line.
 * @param {String} stuff Message
 */
debug(stuff) => OutputDebug("(D) AHK2 (" BFN(Error("", -1).File) "⇨" Error("", -2).what " @ " Error("", -1).line ") " stuff)
/**
 * OutputDebug an (I) message tagged with file and line (view with DebugView).
 * @param {String} stuff Message
 */
dlog(stuff) => OutputDebug("(I) AHK2 (" BFN(Error("", -1).File) " @ " Error("", -1).line ") " stuff)
/**
 * OutputDebug a (W) warning tagged with caller and line.
 * @param {String} stuff Message
 */
warning(stuff) => OutputDebug("(W) AHK2 (" Error("", -2).what " @ " Error("", -1).line ") " stuff)
/**
 * OutputDebug an (E) error tagged with caller and line.
 * @param {String} stuff Message
 */
logError(stuff) => OutputDebug("(E) AHK2 (" Error("", -2).what " @ " Error("", -1).line ") " stuff)
/**
 * Log an Error object (message, location and call stack) and show a tray notification.
 * @param {Error} e Caught error
 * @param {String} extra Optional prefix for the message
 */
elog(e, extra := "") {
   OutputDebug("(E) AHK2 " (extra ? extra " " : "") e.Message ", from " e.What " @ line " e.Line)
   If (e.HasProp("Extra") && e.Extra)
      OutputDebug(" AHK2 Specifically " e.Extra)
   For line in StrSplit(e.Stack, '`n') {
      If (line := Trim(line, ' `n`r'))
         OutputDebug(" ⇨ (" A_Index ") Stack:" line)
   }
   TrayTip
   TrayTip("AHK Error: " e.Message ", from " e.What " @ line " e.Line ,"Autohotkey Error","Iconx")
}
/**
 * Return the file name portion of a path.
 * @param {String} fpath Full path
 * @returns {String} File name with extension
 */
BFN(fpath) {
   SplitPath(fpath, &fName)
   Return fName
}
/**
 * Format a value as zero-padded hex, e.g. 0x0000abcd.
 * @param {Integer} val Value
 * @returns {String}
 */
hx(val) => Format("{:#010x}", val)
/**
 * Format a value as uppercase hex, e.g. 0xABCD.
 * @param {Integer} val Value
 * @returns {String}
 */
hex(val) => Format("0x{:X}", val)
/**
 * Constrain a value to a min/max.
 * @param {Number} l Lower constraint
 * @param {Number} r Upper constraint
 * @param {Number} a Actual value
 * @returns {Number} Constrained value
 */
constrain(l, r, a) => (a > r ? r : (a < l ? l : a))
/**
 * Constrain a value to a min/max (argument order: value, min, max).
 * @param {Number} Num Value
 * @param {Number} MinNum Lower bound
 * @param {Number} MaxNum Upper bound
 * @returns {Number} Constrained value
 */
MinMax(Num, MinNum, MaxNum) => Min(Max(Num, MinNum), MaxNum)
/**
 * Show a tooltip briefly.
 * @param {String} Txt Tooltip text
 * @param {Integer} to Display time in milliseconds
 */
ttMsg(Txt, to := 1000) {
   ToolTip(Txt)
   SetTimer(ToolTip, -to)
}
/**
 * Numeric range enumerator for use in for-loops.
 * https://www.autohotkey.com/boards/viewtopic.php?f=83&t=107759
 * e.g. for v in Range(10, 1, -1)
 * @param {Number} Start First value
 * @param {Number} Stop Last value (inclusive)
 * @param {Number} Step Increment (negative to count down)
 * @returns {Func} Enumerator
 */
Range(Start, Stop, Step := 1) => (&n) => (n := Start, Start += Step, Step > 0 ? n <= Stop : n >= Stop)
/**
 * Check whether the current hotkey is the same as the previous one.
 * Note: A_ThisHotkey/A_PriorHotkey don't change during the loop, so this effectively
 * returns true (after waiting `to` ms) if the hotkey repeated, false otherwise.
 * @param {Integer} to Time to wait in milliseconds
 * @returns {Integer} true if the hotkey repeated
 */
isMashed(to) {
   Then := A_TickCount + to
   While (A_ThisHotkey = A_PriorHotkey) {
      debug(A_ThisHotkey)
      If (A_TickCount > Then) {
         Return true
      }
      Sleep(50)
   }
   debug("Not Mashed")
   Return false
}
/**
 * Check whether the current hotkey repeats the previous one within a time window.
 * @param {Integer} to Window in milliseconds
 * @returns {Integer} true if repeated within `to` ms
 */
isRepeat(to) => (A_ThisHotkey = A_PriorHotkey) AND (A_TimeSincePriorHotkey < to)
/**
 * Trim this process's working set to release unused memory.
 * @returns {Integer} Nonzero on success
 */
PruneMemory() => DllCall("psapi\EmptyWorkingSet", "Ptr", -1, "Int")

dlog("Include File Loaded")

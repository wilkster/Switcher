;----------------------------------------------------------------------------
; DLL Factory, wrap system DLL calls
;----------------------------------------------------------------------------
; #Requires AutoHotkey v2.0
#Requires AutoHotkey v2.1-

#Include Structures.ahk2
#Include Constants.ahk2
; #Include vda.ahk2

;----------------------------------------------------------------------------
; Dark mode / theming
; https://www.autohotkey.com/boards/viewtopic.php?t=94661
; https://github.com/ysc3839/win32-darkmode/blob/cc26549b65b25d6f3168a80238792545bd401271/win32-darkmode/DarkMode.h#L99
; https://gist.github.com/rounk-ctrl/b04e5622e30e0d62956870d5c22b7017
;----------------------------------------------------------------------------
/**
 * Align popup menus with the user's dark/light mode setting.
 * Call this before posting menus so they render dark when the system uses dark mode.
 * Uses undocumented uxtheme ordinals (135 = SetPreferredAppMode, 136 = FlushMenuThemes, 1903+).
 * @returns {void}
 */
alignWithDarkMode() {
   Val := RegRead("HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize", "SystemUsesLightTheme", 1)
   If (Val = 0) {
      uxtheme := DllCall("GetModuleHandle", "str", "uxtheme", "ptr")
      If (!uxtheme)
         uxtheme := DllCall("LoadLibrary", "str", "uxtheme", "ptr")
      If (!uxtheme)
         Return
      ; fnShouldAppsUseDarkMode  := GetProcAddress(uxtheme, 132)	; ordinal =132
      ; AllowDarkModeForWindow := GetProcAddress(uxtheme, 133)	; ordinal =133
      SetPreferredAppMode := GetProcAddress(uxtheme, 135)	; ordinal =135 in 1903+
      FlushMenuThemes := GetProcAddress(uxtheme, 136)	; ordinal = 136
      If (!SetPreferredAppMode || !FlushMenuThemes)
         Return

      ; This is for menus
      ;0=Default  1=AllowDark  2=ForceDark  3=ForceLight  4=Max
      DllCall(SetPreferredAppMode, "int", 1)	; Allow Dark
      DllCall(FlushMenuThemes)

      ; Below isn't necessary, only used for treeview controls and may not apply any more
      ;DllCall("uxtheme\SetWindowTheme", "ptr", A_ScriptHwnd, "str", "DarkMode_Explorer", "ptr", 0)
   }
}
/**
 * Apply a visual theme to a ListView or TreeView control.
 * Unused - causes vertical lines on ListView.
 * @param {Integer} ctrlHwnd Handle of the ListView/TreeView control
 * @param {String} WindowTheme Theme name, e.g. "Explorer" or "DarkMode_Explorer"
 * @returns {Integer} true if the theme was applied, false otherwise
 */
SetExplorerTheme(ctrlHwnd, WindowTheme := "Explorer") {
   If (DllCall("GetVersion", "UChar") > 5) {
      VarSetStrCapacity(&ClassName, 1024)
      If (DllCall("user32\GetClassName", "Ptr", ctrlHwnd, "Str", ClassName, "Int", 512, "Int")) {
         If (ClassName = "SysListView32") || (ClassName = "SysTreeView32")
            Return !DllCall("uxtheme\SetWindowTheme", "Ptr", ctrlHwnd, "Str", WindowTheme, "Ptr", 0)
      }
   }
   Return false
}
;----------------------------------------------------------------------------
; DLL Wrappers
;----------------------------------------------------------------------------
/**
 * Return the address of an exported function or ordinal from a loaded DLL.
 * @param {Integer} hDLL Handle of the loaded module (from GetModuleHandle/LoadLibrary)
 * @param {String|Integer} strModule Function name, or an integer ordinal
 * @returns {Integer} Function address, or 0 on failure
 */
GetProcAddress(hDLL, strModule) {
   If (IsInteger(strModule)) {
      ; The function's ordinal value
      Return DllCall("Kernel32.dll\GetProcAddress", "Ptr", hDLL, "Ptr", strModule, "Ptr")
   } Else {
      ; The function or variable name (convert to ansi string)
      Return DllCall("Kernel32.dll\GetProcAddress", "Ptr", hDLL, "AStr", strModule, "Ptr")
   }
}
/**
 * Return the last Win32 error code from the most recent DllCall.
 * Calling kernel32\GetLastError via DllCall is unreliable because AHK itself
 * may change the value between calls, so A_LastError is used instead.
 * @returns {Integer} Win32 error code
 */
GetLastError() => A_LastError
/**
 * Return the address of a function in an already-loaded standard DLL (e.g. User32).
 * TODO - requires the DLL to be already loaded, implement LoadLibrary fallback.
 * @param {String} strModule Function name
 * @param {String} strDLL DLL name, e.g. "User32.dll"
 * @returns {Integer} Function address, or 0 on failure
 */
GetModHandle(strModule, strDLL) =>
   DllCall("GetProcAddress", "Ptr", DllCall("GetModuleHandle", "Str", strDLL, "Ptr"), "AStr", strModule, "Ptr")

;----------------------------------------------------------------------------
; User32 Clipboard Related
;----------------------------------------------------------------------------
/**
 * Open the clipboard for examination and prevent other apps from modifying it.
 * @param {Integer} hWnd Window to associate with the open clipboard (0 = current task)
 * @returns {Integer} Nonzero on success
 */
OpenClipboard(hWnd := 0) => DllCall("User32.dll\OpenClipboard", "Ptr", hWnd, "Int")
/**
 * Close the clipboard.
 * @returns {Integer} Nonzero on success
 */
CloseClipboard() => DllCall("User32.dll\CloseClipboard", "Int")
/**
 * Empty the clipboard (clipboard must be open).
 * @returns {Integer} Nonzero on success
 */
EmptyClipboard() => DllCall("User32.dll\EmptyClipboard", "Int")
/**
 * Retrieve clipboard data in the specified format (clipboard must be open).
 * @param {Integer} clipFormat Clipboard format (CF_* or registered format)
 * @returns {Integer} Handle to the data, or 0 on failure
 */
GetClipboardData(clipFormat) => DllCall("User32.dll\GetClipboardData", "UInt", clipFormat, "Ptr")
/**
 * Place data on the clipboard in the specified format (clipboard must be open).
 * @param {Integer} clipFormat Clipboard format (CF_* or registered format)
 * @param {Integer} hMem Global memory handle containing the data
 * @returns {Integer} Handle to the data, or 0 on failure
 */
SetClipboardData(clipFormat, hMem) => DllCall("User32.dll\SetClipboardData", "UInt", clipFormat, "Ptr", hMem, "Ptr")
/**
 * Register a new clipboard format (or get the id of an existing one).
 * @param {String} clipFormat Name of the format, e.g. "HTML Format"
 * @returns {Integer} Format id, or 0 on failure
 */
RegisterClipboardFormat(clipFormat) => DllCall("User32.dll\RegisterClipboardFormatW", "Str", clipFormat, "UInt")
/**
 * Check whether the clipboard contains data in the specified format.
 * @param {Integer} clipFormat Clipboard format id
 * @returns {Integer} Nonzero if available
 */
IsClipboardFormatAvailable(clipFormat) => DllCall("User32.dll\IsClipboardFormatAvailable", "UInt", clipFormat, "Int")
/**
 * Return the window that currently has the clipboard open.
 * @returns {Integer} Window handle, or 0 if none
 */
GetOpenClipboardWindow() => DllCall("User32.dll\GetOpenClipboardWindow", "Ptr")
/**
 * Return the first window in the clipboard viewer chain.
 * @returns {Integer} Window handle, or 0 if none
 */
GetClipboardViewer() => DllCall("User32.dll\GetClipboardViewer", "Ptr")


;----------------------------------------------------------------------------
; User32 Window related
; TODO: Create myWin class to group these static methods
; https://github.com/thqby/ahk2_lib/blob/master/WinAPI/User32.ahk
;----------------------------------------------------------------------------
/**
 * Send a message to a window and return immediately; the callback is invoked when processed.
 * @param {Integer} hWnd Target window
 * @param {Integer} Msg Message id
 * @param {Integer} wParam Message wParam
 * @param {Integer} lParam Message lParam
 * @param {Integer} lpCallBack Callback address (CallbackCreate)
 * @param {Integer} dwData Value passed to the callback
 * @returns {Integer} Nonzero on success
 */
SendMessageCallback(hWnd, Msg, wParam, lParam, lpCallBack, dwData) =>
   DllCall('User32\SendMessageCallback', 'ptr', hWnd, 'uint', Msg, 'uptr', wParam, 'uptr', lParam, 'ptr', lpCallBack, 'uptr', dwData, 'int')
/**
 * Send a message to a window, waiting at most uTimeout ms for it to be processed.
 * @param {Integer} hWnd Target window
 * @param {Integer} Msg Message id
 * @param {Integer} wParam Message wParam
 * @param {Integer} lParam Message lParam
 * @param {Integer} fuFlags SMTO_* flags
 * @param {Integer} uTimeout Timeout in milliseconds
 * @param {VarRef} lpdwResult Receives the message result
 * @returns {Integer} Nonzero on success, 0 on timeout/failure
 */
SendMessageTimeout(hWnd, Msg, wParam, lParam, fuFlags, uTimeout, &lpdwResult := 0) =>
   DllCall('User32\SendMessageTimeout', 'ptr', hWnd, 'uint', Msg, 'uptr', wParam, 'uptr', lParam, 'uint', fuFlags, 'uint', uTimeout, 'uptr*', &lpdwResult, 'ptr')
; SendMessageA(hWnd, Msg, wParam, lParam) => DllCall('User32\SendMessageA', 'ptr', hWnd, 'uint', Msg, 'uptr', wParam, 'uptr', lParam, 'ptr')
; SendMessageW(hWnd, Msg, wParam, lParam) => DllCall('User32\SendMessageW', 'ptr', hWnd, 'uint', Msg, 'uptr', wParam, 'uptr', lParam, 'ptr')
/**
 * Wait until the process owning a window is idle waiting for input.
 * Note: WaitForInputIdle only waits once per process; later calls return immediately,
 * so this is only useful during application startup.
 * @param {Integer} hWnd Window owned by the process
 * @param {Integer} to Timeout in milliseconds
 * @returns {Integer|String} 0 when idle, WAIT_TIMEOUT (258), WAIT_FAILED (-1),
 *    or "OpenProcess ERROR" if the process could not be opened
 */
WaitForInputIdle(hWnd, to) {
   ProcessId := WinGetPID(hWnd)
   If (!(hProcess := DllCall("Kernel32.dll\OpenProcess", "UInt", 0x0400, "Int", false, "UInt", ProcessId, "Ptr"))) {
      Return "OpenProcess ERROR"
   }
   res := DllCall("User32.dll\WaitForInputIdle", "Ptr", hProcess, "UInt", to, "Int")
   DllCall("Kernel32.dll\CloseHandle", "Ptr", hProcess)
   Return res
}
/**
 * Set all system cursors to a busy hourglass, or restore the originals.
 * Repeated "busy" calls are ignored until the cursor is restored.
 * @param {Integer} busy true to set the hourglass, false to restore
 * @returns {void}
 */
SetBusyCursor(busy) {
   Static savedCursors := Map()
   Static cursorIDs := [32512, 32513, 32514, 32515, 32516, 32640, 32641, 32642, 32643, 32644, 32645, 32646, 32648, 32649, 32650, 32651]

   If (busy) {
      ; Already busy - don't overwrite the saved originals with hourglass copies
      If (savedCursors.Count > 0)
         Return
      ; Load the hourglass cursor
      hWait := DllCall("LoadCursor", "Ptr", 0, "Ptr", 32514, "Ptr")  ; IDC_WAIT = 32514
      ; Replace all system cursors with the hourglass, saving originals
      For id in cursorIDs {
         hCurrent := DllCall("CopyImage",
            "Ptr", DllCall("LoadCursor", "Ptr", 0, "Ptr", id, "Ptr"),
            "UInt", 2,   ; IMAGE_CURSOR
            "Int", 0, "Int", 0,
            "UInt", 0, "Ptr")
         savedCursors[id] := hCurrent
         DllCall("SetSystemCursor", "Ptr", DllCall("CopyImage", "Ptr", hWait, "UInt", 2, "Int", 0, "Int", 0, "UInt", 0, "Ptr"), "UInt", id)
      }
   } Else {
      ; Restore all saved cursors
      If (savedCursors.Count > 0) {
         For id, hCursor in savedCursors {
            DllCall("SetSystemCursor", "Ptr", hCursor, "UInt", id)
         }
         savedCursors := Map()
      } Else {
         ; No saved cursors, just reload system defaults
         DllCall("SystemParametersInfo", "UInt", 0x0057, "UInt", 0, "Ptr", 0, "UInt", 0)  ; SPI_SETCURSORS
      }
   }
}
/**
 * Set all system cursors to one cursor (for resizing/moving), or restore the defaults.
 * https://www.autohotkey.com/boards/viewtopic.php?t=13284
 * https://www.autohotkey.com/boards/viewtopic.php?t=75867
 * APPSTARTING: 32650, ARROW: 32512, CROSS: 32515, HAND: 32649, HELP: 32651, IBEAM: 32513, NO: 32648,
 * SIZEALL: 32646, SIZENESW: 32643, SIZENS: 32645, SIZENWSE: 32642, SIZEWE: 32644, UPARROW: 32516, WAIT: 32514
 * @param {Integer|String} Cursor OCR_* cursor id, or "" to restore system cursors
 * @returns {void}
 */
SetSystemCursor(Cursor := "") {
   Static Cursors := [32650, 32512, 32515, 32649, 32651, 32513, 32648, 32646, 32643, 32645, 32642, 32644, 32516, 32514]
   Static SPI_SETCURSORS := 0x57
   Static LR_SHARED := 0x8000
   Static IMAGE_CURSOR := 2
   If (Cursor == "") {
      ; Restore system cursor
      DllCall("User32.dll\SystemParametersInfoW", "UInt", SPI_SETCURSORS, "UInt", 0, "Ptr", 0, "UInt", 0)
   } Else {
      ; LoadCursor is superseded, use LoadImage instead
      ; When loading a system icon or cursor, you must use LR_SHARED (0x8000) or the function will fail to load the resource
      hCursor := DllCall("User32.dll\LoadImage", "Ptr", 0, "Ptr", Cursor, "UInt", IMAGE_CURSOR, "Int", 0, "Int", 0, "UInt", LR_SHARED, "Ptr")
      ; Set all the default system cursors to the chosen cursor.
      ; CopyImage is necessary as SetSystemCursor destroys the cursor we pass to it after using it.
      For v in Cursors {
         DllCall("User32.dll\SetSystemCursor"
            , "Ptr", DllCall("User32.dll\CopyImage", "Ptr", hCursor, "UInt", IMAGE_CURSOR, "Int", 0, "Int", 0, "UInt", 0, "Ptr")
            , "UInt", v)
      }
   }
}
/**
 * Check whether the mouse cursor is at the top-left corner (0,0) of the primary monitor.
 * @returns {Integer} true if the cursor is at 0,0
 */
CursorInCorner() {
   Static GetCursorPos := GetModHandle("GetCursorPos", "User32.dll")
   DllCall(GetCursorPos, "Int64*", &POINT := 0)
   Return POINT = 0
}
/**
 * Hit-test the window under the cursor to find which part of it the cursor is over.
 * https://learn.microsoft.com/en-us/windows/win32/inputdev/wm-nchittest
 * Untested.
 * @returns {Integer} HT* hit-test value (e.g. HTCLIENT = 1, HTCAPTION = 2)
 */
CursorTest() {
   CoordMode("Mouse", "Screen")
   MouseGetPos(&mx0, &my0, &hWnd)
   Return SendMessage(WM_NCHITTEST, 0, (mx0 & 0xFFFF) | (my0 & 0xFFFF) << 16, , hWnd)
}
/**
 * Return the id of the process that created a window (same as WinGetPID).
 * @param {Integer} hWnd Window handle
 * @returns {Integer} Process id, or 0 on failure
 */
GetWindowThreadProcessId(hWnd) {
   DllCall("User32\GetWindowThreadProcessId", "Ptr", hWnd, "UInt*", &pid := 0, "UInt")
   Return pid
}
/**
 * Get the control that has keyboard focus in the thread owning a window.
 * @param {Integer} hWnd Top-level window handle
 * @returns {Integer} Handle of the focused control, or hWnd on failure
 */
getFocusWindow(hWnd) {
   st := stGUITHREADINFO()
   threadId := DllCall("User32\GetWindowThreadProcessId", "Ptr", hWnd, "Ptr", 0, "UInt")
   If DllCall("User32.dll\GetGUIThreadInfo", "UInt", threadId, "Ptr", st, "Int") {
      Return st.hwndFocus
   } Else {
      Warning("GetGUIThreadInfo " A_LastError)
      Return hWnd
   }
}

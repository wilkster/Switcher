#Include ..\common\dllFactory.ahk2
/*
   Return icon bitmaps for UWP apps including getting their AUMID string from the window handle
*/
Class UWP {
   ; Returns the AppUserModelID of a window, or "" if it has none ApplicationFrameHost
   Static GetWindowAumid(hwnd) {
      Static iid := 0, pkey := 0
      If !iid {
         iid := Buffer(16), pkey := Buffer(20)
         DllCall("ole32\CLSIDFromString", "WStr", "{886D8EEB-8CF2-4446-8D02-CDBA1DBDCF99}", "Ptr", iid)
         DllCall("ole32\CLSIDFromString", "WStr", "{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}", "Ptr", pkey)
         NumPut("UInt", 5, pkey, 16)                                ; pid = 5
      }

      aumid := ""
      If DllCall("shell32\SHGetPropertyStoreForWindow", "Ptr", hwnd, "Ptr", iid, "Ptr*", &ps := 0) >= 0 {
         pv := Buffer(24, 0)                                        ; PROPVARIANT, x64
         If ComCall(5, ps, "Ptr", pkey, "Ptr", pv) >= 0             ; IPropertyStore::GetValue
            If NumGet(pv, 0, "UShort") = 31                         ; VT_LPWSTR
               aumid := StrGet(NumGet(pv, 8, "Ptr"))
         DllCall("ole32\PropVariantClear", "Ptr", pv)
         ObjRelease(ps)
      }
      Return aumid != "" ? aumid : this.GetWindowAumid2(hwnd)
   }
   /**
    * Backup method to try to get the icon
    * @param hwnd Window Handle
    * @returns {String} 
    */
   Static GetWindowAumid2(hwnd) {
      pid := 0
      If hCore := DllCall("FindWindowExW", "Ptr", hwnd, "Ptr", 0, "WStr", "Windows.UI.Core.CoreWindow", "Ptr", 0, "Ptr")
         DllCall("GetWindowThreadProcessId", "Ptr", hCore, "UInt*", &pid)
      Else
         DllCall("GetWindowThreadProcessId", "Ptr", hwnd, "UInt*", &pid)   ; not a frame-hosted window
      If !hProc := DllCall("OpenProcess", "UInt", 0x1000, "Int", 0, "UInt", pid, "Ptr")   ; PROCESS_QUERY_LIMITED_INFORMATION
         Return ""
      len := 256, buf := Buffer(len * 2)
      rc := DllCall("GetApplicationUserModelId", "Ptr", hProc, "UInt*", &len, "Ptr", buf)
      DllCall("CloseHandle", "Ptr", hProc)
      Return rc ? "" : StrGet(buf)
   }
   /**
    * The simplest route is to skip the manifest and logo-asset hunting
      (Square44x44Logo.targetsize-*.png, scale variants, etc.) and ask the shell
      for the icon. UWP apps are addressable as shell:AppsFolder\<AUMID>, so you
      can parse that to a PIDL and hand it to SHGetFileInfoW.
    * Return a HICON from a UWP app knowing its AUMID, avoids old method of
      going through the manifest file
    * Caller must later destroy the icon
    * @param aumid UWP AUMID string name
    * @param {Integer} small Icon Size
    * @returns {Integer | Float} 
    */
   Static GetUWPIcon(aumid, small := 0) {
      If DllCall("shell32\SHParseDisplayName", "WStr", "shell:AppsFolder\" aumid, "Ptr", 0, "Ptr*", &pidl := 0, "UInt", 0, "Ptr", 0) < 0
         Return 0
      sfi := Buffer(A_PtrSize + 688, 0)               ; SHFILEINFOW
      DllCall("shell32\SHGetFileInfoW", "Ptr", pidl, "UInt", 0, "Ptr", sfi, "UInt", sfi.Size, "UInt", 0x108 | small)                  ; SHGFI_ICON | SHGFI_PIDL | SHGFI_SMALLICON
      DllCall("ole32\CoTaskMemFree", "Ptr", pidl)
      Return NumGet(sfi, 0, "Ptr")
   }
   /**
    * Return a bitmap of arbitray size, We use HICONs internally so not really used here
    * @param aumid AUMID of app
    * @param {Integer} size 
    * @param {Integer} flags 
    * @returns {Integer} 
    */
   Static GetUWPBitmap(aumid, size := 48, flags := 0x4) {          ; 0x4 = SIIGBF_ICONONLY
      static iid := 0
      if !iid {
         iid := Buffer(16)
         DllCall("ole32\CLSIDFromString", "WStr", "{BCC18B79-BA16-442F-80C4-8A59C30C463B}", "Ptr", iid)  ; IShellItemImageFactory
      }

      If DllCall("shell32\SHCreateItemFromParsingName", "WStr", "shell:AppsFolder\" aumid, "Ptr", 0, "Ptr", iid, "Ptr*", &psif := 0) < 0
         return 0

      hbm := 0
      ; GetImage is vtable index 3; SIZE is passed by value, so pack cx | cy<<32 into one Int64
      ComCall(3, psif, "Int64", size | size << 32, "UInt", flags, "Ptr*", &hbm)
      ObjRelease(psif)
      return hbm                                                    ; caller must DeleteObject, 0 on failure
   }   
}
dlog("Include File Loaded")